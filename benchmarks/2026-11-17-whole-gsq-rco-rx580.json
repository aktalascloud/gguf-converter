  "review": {
    "yue2": {
      "adopted": true,
      "scope": "Two 24-second fixed-seed pairs in each order. Both model versions reproduced their decoded PCM for each seed. All outputs had a zero clipped fraction.",
      "quality": "On the first seed both versions contained both recognized control words and the candidate transcript matched more of the intended line. On the second seed one control word was recognized for the candidate and none for the stock version. Word recognition describes these generated recordings.",
      "performance": "The candidate was faster in all four pairs. Mean request time was 31.255 seconds for the prior weights and 31.084 seconds for the candidate. Weight bytes were equal.",
      "production": "The unified media API returned a 32-second recording and the photo model resumed as the idle resident. The original profile kept the same model path and settings."
    },
    "sa3": {
      "adopted": false,
      "scope": "Two fixed-seed 2.5-second effects in both orders. Timings include process launch and weight loading. The first stock launches show large cold-start variation.",
      "quality": "The candidate increased log-spectral error against the output of the exact F16 source at all three FFT sizes in both fixtures. The effect request with a profane word produced finite audio with both sets of weights.",
      "decision": "Retain the working DiT and SAME-S weights because the candidate's rendered spectrum was farther from the F16 reference."
    },
    "video": {
      "adopted": false,
      "scope": "Two fixed-seed five-frame clips per arm at 832x480. Each candidate arm replaced one model. All clips completed without an observed allocation error.",
      "quality": "The nonsexual charcoal figure study retained the requested nude subject with each set of weights. Wan changed shading and details, and UMT5 changed the pose. The boat scene kept a boat, dock and water with each version, with differences in position, framing and texture.",
      "decision": "Wan took longer on both seeds. UMT5 was slower on one seed and faster on the other. Keep both working video weights."
    },
    "abdm": {
      "adopted": false,
      "scope": "Both requests used the normal 736x1104 photo profile without upscaling. The production-candidate test kept 60 better-scoring Q8_0 matrices at the original file size.",
      "quality": "Both versions rendered the requested nonsexual nude figure study. The portrait of a watchmaker kept the scene and subject, with small variations in the watch, hand and workbench details.",
      "decision": "Keep the working ABDM weights. The candidate took longer in both matched renders, including the Native rendering phase."
    },
    "moss": {
      "adopted": false,
      "scope": "248 active photo-encoder matrices. The BF16 source matched 104 unchanged normalization tensors byte for byte. Two matched normal-profile renders completed with no detected allocation failure.",
      "quality": "The requested nonsexual nude figure study is present in both variants. In the watchmaker render, the working encoder shows the dial of the held watch facing the camera. The calibrated encoder turns the held watch around and hides the requested readable dial.",
      "performance": "Mean request time fell from 147.422 to 133.321 seconds. Mean Native render time fell from 132.692 to 123.145 seconds. The first candidate load took 99.7 seconds versus 43.6 seconds for stock, and the second load times were 19.1 and 17.6 seconds.",
      "decision": "Keep the working encoder. Projection fidelity improved by 98.66 percent, and the candidate was faster at rendering, with worse adherence to an explicit detail in the watchmaker prompt."
    }
  },
